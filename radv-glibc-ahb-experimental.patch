+++ b/src/util/xclipse_ahb.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT */
+#include "xclipse_ahb.h"
+#include "c11/threads.h"
+#include "util/log.h"
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include "drm-uapi/drm_fourcc.h"
+
+static once_flag once = ONCE_FLAG_INIT;
+static bool available;
+static struct {
+   int (*allocate)(const AHardwareBuffer_Desc *desc, AHardwareBuffer **out);
+   void (*acquire)(AHardwareBuffer *buffer);
+   void (*release)(AHardwareBuffer *buffer);
+   void (*describe)(const AHardwareBuffer *buffer, AHardwareBuffer_Desc *out);
+   const native_handle_t * (*getNativeHandle)(const AHardwareBuffer *buffer);
+   int (*isSupported)(const AHardwareBuffer_Desc *desc);
+   int (*sendHandleToUnixSocket)(const AHardwareBuffer *buffer, int fd);
+   int (*layout)(const AHardwareBuffer *, uint64_t *, uint32_t *, uint64_t *);
+} api;
+
+static void
+load_bridge(void)
+{
+   const char *path = getenv("RADV_AHB_LIBRARY");
+   void *lib = dlopen(path && path[0] ? path : "libradv_ahb.so", RTLD_NOW | RTLD_LOCAL);
+   if (!lib) {
+      if (path && path[0])
+         mesa_logw("RADV: cannot load AHB bridge: %s", dlerror());
+      return;
+   }
+   api.allocate = dlsym(lib, "AHardwareBuffer_allocate");
+   api.acquire = dlsym(lib, "AHardwareBuffer_acquire");
+   api.release = dlsym(lib, "AHardwareBuffer_release");
+   api.describe = dlsym(lib, "AHardwareBuffer_describe");
+   api.getNativeHandle = dlsym(lib, "AHardwareBuffer_getNativeHandle");
+   api.isSupported = dlsym(lib, "AHardwareBuffer_isSupported");
+   api.sendHandleToUnixSocket = dlsym(lib, "AHardwareBuffer_sendHandleToUnixSocket");
+   api.layout = dlsym(lib, "radv_ahb_get_layout");
+   available = api.allocate && api.acquire && api.release && api.describe && api.getNativeHandle && api.isSupported && api.sendHandleToUnixSocket && api.layout;
+   if (!available) {
+      mesa_logw("RADV: AHB bridge lacks required NDK entrypoints or radv_ahb_get_layout");
+      dlclose(lib);
+   }
+   /* A successful bridge stays loaded for the lifetime of all AHB objects. */
+}
+
+bool
+xclipse_ahb_available(void)
+{
+   call_once(&once, load_bridge);
+   return available;
+}
+
+int
+xclipse_ahb_allocate(const AHardwareBuffer_Desc *desc, AHardwareBuffer **out)
+{
+   if (!xclipse_ahb_available()) { return -ENOSYS; }
+   return api.allocate(desc, out);
+}
+
+void
+xclipse_ahb_acquire(AHardwareBuffer *buffer)
+{
+   if (!xclipse_ahb_available()) { return; }
+   api.acquire(buffer);
+}
+
+void
+xclipse_ahb_release(AHardwareBuffer *buffer)
+{
+   if (!xclipse_ahb_available()) { return; }
+   api.release(buffer);
+}
+
+void
+xclipse_ahb_describe(const AHardwareBuffer *buffer, AHardwareBuffer_Desc *out)
+{
+   if (!xclipse_ahb_available()) { return; }
+   api.describe(buffer, out);
+}
+
+const native_handle_t *
+xclipse_ahb_getNativeHandle(const AHardwareBuffer *buffer)
+{
+   if (!xclipse_ahb_available()) { return NULL; }
+   return api.getNativeHandle(buffer);
+}
+
+int
+xclipse_ahb_isSupported(const AHardwareBuffer_Desc *desc)
+{
+   if (!xclipse_ahb_available()) { return 0; }
+   return api.isSupported(desc);
+}
+
+int
+xclipse_ahb_sendHandleToUnixSocket(const AHardwareBuffer *buffer, int fd)
+{
+   if (!xclipse_ahb_available()) { return -ENOSYS; }
+   return api.sendHandleToUnixSocket(buffer, fd);
+}
+
+int
+xclipse_ahb_layout(const AHardwareBuffer *buffer, uint64_t *mod, uint32_t *pitch, uint64_t *offset)
+{
+   if (!xclipse_ahb_available())
+      return -ENOSYS;
+   int ret = api.layout(buffer, mod, pitch, offset);
+   if (ret)
+      return ret;
+   const native_handle_t *handle = api.getNativeHandle(buffer);
+   if (!handle || handle->numFds < 1 || handle->numInts < 0 || handle->data[0] < 0 ||
+       *mod == DRM_FORMAT_MOD_INVALID || *mod == 1255 || *mod == 1256 || *mod == 1274 || !*pitch)
+      return -EINVAL;
+   return 0;
+}
+
+int
+xclipse_ahb_send(const AHardwareBuffer *buffer, int fd)
+{
+   struct pollfd pfd = {.fd = fd, .events = POLLIN};
+   int ret;
+   do { ret = poll(&pfd, 1, 5000); } while (ret < 0 && errno == EINTR);
+   if (ret <= 0)
+      return ret == 0 ? -ETIMEDOUT : -errno;
+   unsigned char ready;
+   do { ret = recv(fd, &ready, 1, MSG_DONTWAIT); } while (ret < 0 && errno == EINTR);
+   if (ret != 1 || ready != 1)
+      return -EPROTO;
+   return AHardwareBuffer_sendHandleToUnixSocket(buffer, fd);
+}
