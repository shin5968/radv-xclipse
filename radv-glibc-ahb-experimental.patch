index 0000000..20967c7
--- /dev/null
+++ b/docs/xclipse-ahb.md
@@ -0,0 +1,99 @@
+# AHardwareBuffer on glibc and Termux-X11
+
+Build with `./build.sh` (or add `-Dxclipse-ahb=true` to a manual Meson configuration).
+For an existing build directory, enable the new feature once with
+`meson configure build-glibc -Dxclipse-ahb=true` before rebuilding.
+The bridge is optional at runtime. Without it, RADV retains the existing Linux
+DRI3/Wayland paths and does not advertise
+`VK_ANDROID_external_memory_android_hardware_buffer`.
+
+## Bridge contract
+
+Set `RADV_AHB_LIBRARY=/absolute/path/to/libradv_ahb.so`. The default library name
+is `libradv_ahb.so`. It must be **glibc-compatible**; Android's bionic
+`/system/lib64/libandroid.so` cannot be loaded directly into a glibc process.
+The library must implement the standard NDK ABI for:
+
+- `AHardwareBuffer_allocate`, `acquire`, `release`, `describe`
+- `AHardwareBuffer_getNativeHandle`
+- `AHardwareBuffer_isSupported`
+- `AHardwareBuffer_sendHandleToUnixSocket`
+
+It must also export:
+
+```c
+int radv_ahb_get_layout(const struct AHardwareBuffer *buffer,
+                       uint64_t *drm_modifier,
+                       uint32_t *byte_row_pitch,
+                       uint64_t *byte_offset);
+```
+
+Return zero only for a single-plane image whose memory is the first FD in the
+native handle. Return an error for layouts the bridge cannot describe accurately.
+`isSupported` must reflect allocations that this Vulkan layout contract supports.
+The socket sender must use the Android AHB serialization protocol, not a raw FD
+or a custom message format. All AHB entrypoints and objects must belong to the
+same bridge implementation. The bridge remains loaded while the driver runs.
+This repository supplies the client interface, not an Android allocator service
+or a libhybris implementation.
+
+RADV does not infer tiling from CPU usage or pixel stride. Unknown layouts fail
+import rather than silently rendering into an incompatible buffer. This initial
+interface excludes multi-plane YUV image layouts. BLOB memory can be imported
+and exported without an image layout.
+
+## Termux-X11 presentation
+
+With a compatible Termux-X11 server and the bridge available:
+
+```sh
+export RADV_AHB_LIBRARY=/path/to/libradv_ahb.so
+export RADV_TERMUX_X11_AHB=1
+export DISPLAY=:0
+vkcube
+```
+
+The opt-in applies to RGBA8/BGRA8 UNORM windows on a DRI3 1.2-capable connection.
+It allocates each swapchain buffer once through AHB, imports its dma-buf for
+RADV rendering, and sends the same AHB to the server with its private modifier
+`1255` (`AHARDWAREBUFFER_SOCKET_FD`). This value describes socket transport;
+it is never used as the Vulkan image's DRM layout modifier. The server's ready
+byte is consumed before sending the handle, and the X request is checked after
+sending, to avoid a request/receive deadlock. There is no PRIME blit or CPU
+pixel copy in this client path. The server can still composite the image; this
+is not a guarantee of direct scanout.
+
+The transport was checked against [Termux-X11 29d4460](https://github.com/termux/termux-x11/blob/29d4460b26e69b39af023d255a255e2778251952/lorie/src/main/cpp/lorie/InitOutput.c).
+The switch is explicit because that server advertises the ordinary
+linear modifier, rather than advertising the private AHB transport modifier.
+Do not enable it for an unrelated X server. `MESA_VK_WSI_DEBUG=sw` retains the
+CPU-copy path and takes precedence. Unsupported window formats also retain the
+ordinary path. A missing bridge retains the ordinary path; a failed AHB import
+or socket request reports an error instead of presenting uninitialized pixels.
+
+## Synchronization
+
+AHB handle transfer alone does not transfer a render-completion fence. With
+DRI3/Present explicit synchronization, WSI uses GPU timeline synchronization and
+omits the legacy render fence wait. On older servers, including the inspected
+Termux-X11 version, a render-completion wait remains on the presentation worker.
+Removing it without a server-side acquire-fence mechanism can race rendering
+and display. Acquire/release synchronization, swapchain recycling waits, and
+presentation timing waits remain necessary. No CPU-wait-free or frame-rate
+improvement is claimed without measurements on the phone.
+
+## Validation
+
+Enable `-Dxclipse-ahb-tests=true`, then run:
+
+```sh
+meson test -C build-glibc --suite xclipse-ahb --print-errorlogs
+```
+
+Mock-bridge tests cover missing/incomplete libraries, concurrent initialization,
+reference ownership and FD closure, padded row pitches, rejected layouts, and
+valid/invalid socket handshakes. They do not validate Android gralloc or GPU
+execution. On a phone, additionally check extension enumeration with `vulkaninfo`,
+run `vkcube` in FIFO/mailbox/immediate modes, resize windows, and test both
+`RADV_TERMUX_X11_AHB=0` and `1`. Compare frame times and verify buffer contents
+and acquire/release behavior before claiming a performance improvement.
diff --git a/src/util/tests/xclipse_ahb_mock.c b/src/util/tests/xclipse_ahb_mock.c
new file mode 100644
index 0000000..4e92ff1
--- /dev/null
+++ b/src/util/tests/xclipse_ahb_mock.c
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#define XCLIPSE_AHB_NO_ALIASES
+#include "util/xclipse_ahb.h"
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+int AHardwareBuffer_allocate(const AHardwareBuffer_Desc *, AHardwareBuffer **);
+void AHardwareBuffer_acquire(AHardwareBuffer *);
+void AHardwareBuffer_release(AHardwareBuffer *);
+void AHardwareBuffer_describe(const AHardwareBuffer *, AHardwareBuffer_Desc *);
+const native_handle_t *AHardwareBuffer_getNativeHandle(const AHardwareBuffer *);
+int AHardwareBuffer_isSupported(const AHardwareBuffer_Desc *);
+int AHardwareBuffer_sendHandleToUnixSocket(const AHardwareBuffer *, int);
+int radv_ahb_get_layout(const AHardwareBuffer *, uint64_t *, uint32_t *, uint64_t *);
+
+struct AHardwareBuffer {
+   AHardwareBuffer_Desc desc;
+   unsigned refs;
+   struct { int version, numFds, numInts, fd; } handle;
+};
+
+int AHardwareBuffer_allocate(const AHardwareBuffer_Desc *desc, AHardwareBuffer **out)
+{
+   *out = calloc(1, sizeof(**out));
+   if (!*out) return -1;
+   (*out)->desc = *desc;
+   (*out)->desc.stride = desc->width + 16;
+   (*out)->refs = 1;
+   (*out)->handle.version = sizeof(native_handle_t);
+   (*out)->handle.numFds = 1;
+   (*out)->handle.fd = memfd_create("mock-ahb", MFD_CLOEXEC);
+   if ((*out)->handle.fd < 0 || ftruncate((*out)->handle.fd, (desc->width + 16) * desc->height * 4)) {
+      if ((*out)->handle.fd >= 0) close((*out)->handle.fd);
+      free(*out); *out = NULL; return -1;
+   }
+   return 0;
+}
+void AHardwareBuffer_acquire(AHardwareBuffer *b) { b->refs++; }
+void AHardwareBuffer_release(AHardwareBuffer *b)
+{
+   if (!--b->refs) { close(b->handle.fd); free(b); }
+}
+void AHardwareBuffer_describe(const AHardwareBuffer *b, AHardwareBuffer_Desc *desc) { *desc = b->desc; }
+const native_handle_t *AHardwareBuffer_getNativeHandle(const AHardwareBuffer *b)
+{ return (const native_handle_t *)&b->handle; }
+int AHardwareBuffer_isSupported(const AHardwareBuffer_Desc *desc)
+{ return desc->format == AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM; }
+int AHardwareBuffer_sendHandleToUnixSocket(const AHardwareBuffer *b, int fd)
+{
+   const char marker = 42;
+   return send(fd, &marker, 1, MSG_NOSIGNAL) == 1 ? 0 : -1;
+}
+#ifndef NO_LAYOUT
+int radv_ahb_get_layout(const AHardwareBuffer *b, uint64_t *modifier, uint32_t *pitch, uint64_t *offset)
+{
+   if (getenv("MOCK_AHB_BAD_LAYOUT")) return -1;
+   *modifier = getenv("MOCK_AHB_TRANSPORT_LAYOUT") ? 1255 : 0;
+   *pitch = b->desc.stride * 4; *offset = 0;
+   return 0;
+}
+#endif
diff --git a/src/util/tests/xclipse_ahb_test.c b/src/util/tests/xclipse_ahb_test.c
new file mode 100644
index 0000000..7da6496
--- /dev/null
+++ b/src/util/tests/xclipse_ahb_test.c
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: MIT */
+#include "util/xclipse_ahb.h"
+#include "c11/threads.h"
+#include <assert.h>
+#include <errno.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static int available_thread(void *unused)
+{
+   return xclipse_ahb_available() ? 0 : 1;
+}
+
+struct peer { int fd; bool valid; };
+static int server(void *data)
+{
+   struct peer *p = data;
+   char ready = p->valid ? 1 : 0, marker = 0;
+   assert(send(p->fd, &ready, 1, MSG_NOSIGNAL) == 1);
+   if (p->valid) {
+      assert(recv(p->fd, &marker, 1, 0) == 1);
+      assert(marker == 42);
+   }
+   close(p->fd);
+   return 0;
+}
+
+int main(int argc, char **argv)
+{
+   assert(argc == 2);
+   if (!strcmp(argv[1], "unavailable")) {
+      assert(!xclipse_ahb_available());
+      AHardwareBuffer_Desc desc = {0};
+      AHardwareBuffer *b = NULL;
+      assert(AHardwareBuffer_allocate(&desc, &b) == -ENOSYS);
+      return 0;
+   }
+   thrd_t threads[16];
+   for (unsigned i = 0; i < 16; i++) assert(thrd_create(&threads[i], available_thread, NULL) == thrd_success);
+   for (unsigned i = 0; i < 16; i++) {
+      int ret = -1;
+      assert(thrd_join(threads[i], &ret) == thrd_success && ret == 0);
+   }
+   AHardwareBuffer_Desc desc = {.width = 64, .height = 32, .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM, .usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT};
+   assert(AHardwareBuffer_isSupported(&desc));
+   AHardwareBuffer *b = NULL;
+   assert(AHardwareBuffer_allocate(&desc, &b) == 0 && b);
+   AHardwareBuffer_acquire(b);
+   AHardwareBuffer_release(b);
+   AHardwareBuffer_describe(b, &desc);
+   assert(desc.width == 64 && desc.stride == 80);
+   const native_handle_t *handle = AHardwareBuffer_getNativeHandle(b);
+   int fd = handle->data[0];
+   assert(handle->numFds == 1 && fd >= 0);
+   uint64_t mod = UINT64_MAX, offset = UINT64_MAX;
+   uint32_t pitch = 0;
+   if (!strcmp(argv[1], "bad-layout")) {
+      assert(xclipse_ahb_layout(b, &mod, &pitch, &offset) != 0);
+   } else {
+      assert(xclipse_ahb_layout(b, &mod, &pitch, &offset) == 0);
+      assert(mod == 0 && pitch == 320 && offset == 0);
+      for (int valid = 0; valid < 2; valid++) {
+         int sockets[2];
+         assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0);
+         struct peer peer = {.fd = sockets[1], .valid = valid};
+         thrd_t worker;
+         assert(thrd_create(&worker, server, &peer) == thrd_success);
+         assert(xclipse_ahb_send(b, sockets[0]) == (valid ? 0 : -EPROTO));
+         close(sockets[0]);
+         assert(thrd_join(worker, NULL) == thrd_success);
+      }
+   }
+   AHardwareBuffer_release(b);
+   errno = 0;
+   assert(close(fd) == -1 && errno == EBADF);
+   return 0;
+}
